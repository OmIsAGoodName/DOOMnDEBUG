{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Series",
  "type": "object",
  "required": ["id", "title", "world", "tone", "age_band", "character_ids"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "world": {
      "type": "object",
      "required": ["setting"],
      "properties": {
        "setting": { "type": "string" },
        "rules": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "tone": { "type": "string" },
    "age_band": { "type": "string", "enum": ["3-5", "4-6", "6-8"] },
    "language": { "type": "string", "default": "en" },
    "character_ids": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

